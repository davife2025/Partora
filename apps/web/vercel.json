{
  "framework": "nextjs",
  "buildCommand": "cd ../.. && npx turbo run build --filter=@partora/web --force",
  "outputDirectory": ".next",
  "installCommand": "cd ../.. && npm install",
  "regions": ["iad1"],

  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control",          "value": "public, max-age=0, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    }
  ]
}